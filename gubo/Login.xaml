<Window x:Class="KretaKlon.gubo.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Title="Login" Height="200" Width="300">
    <Grid Background="#424242">
        <StackPanel VerticalAlignment="Center">
            <Label Margin="0, 10" HorizontalAlignment="Center" Foreground="White" FontSize="18" FontWeight="Bold">Kérem írja be a tanuló jelszavát:</Label>
            <TextBox x:Name="PasswordTextBox" Margin="0, 10" Width="200"/>
            <Button Content="Ok" Margin="0, 10" Width="200" Click="Button_Click"></Button>
            <Button Content="Mégse" Margin="0, 10" Width="200" Click="Button_Click_1"/>
        </StackPanel>
    </Grid>
</Window>
